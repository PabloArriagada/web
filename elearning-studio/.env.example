# ---------------------------------------------------------------
# Studio E-learning — variables de entorno (copiar a .env)
# Ninguna clave privada se expone al navegador: solo el servidor
# lee este archivo.
# ---------------------------------------------------------------

# Puerto HTTP del servidor API (también sirve la app web compilada).
PORT=3000
HOST=0.0.0.0

# Nivel de logs estructurados (pino): fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# PostgreSQL. Con docker compose: postgres://studio:studio@localhost:5432/studio
DATABASE_URL=postgres://studio:studio@localhost:5432/studio

# Almacenamiento de objetos: "s3" (MinIO/S3) o "fs" (carpeta local, sin Docker).
STORAGE_DRIVER=fs

# Driver fs: carpeta donde se guardan los binarios.
STORAGE_FS_ROOT=./.data/storage

# Driver s3 (MinIO en desarrollo). Credenciales solo en servidor.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=studio-assets
S3_ACCESS_KEY_ID=studio
S3_SECRET_ACCESS_KEY=studio-secret
S3_FORCE_PATH_STYLE=true

# Límites de subida (bytes). 500 MB por defecto.
MAX_UPLOAD_BYTES=524288000

# Tiempo de vida (minutos) de las compilaciones de preview en memoria.
PREVIEW_TTL_MINUTES=60
